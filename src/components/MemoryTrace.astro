---
const example = 'Use TypeScript for new projects.';
---

<memory-trace class="trace" data-mode="local">
  <div class="trace-header">
    <div class="trace-label"><span class="lamp" aria-hidden="true"></span> MEMORY TRACE <span class="trace-id">/ 001</span></div>
    <div class="trace-controls" role="group" aria-label="Embedding location" hidden>
      <button type="button" data-mode-button="local" aria-pressed="true">Local model</button>
      <button type="button" data-mode-button="hosted" aria-pressed="false">Hosted API</button>
    </div>
  </div>

  <div class="trace-body">
    <div class="agent-line" data-stop="agent">
      <div class="agent-symbol" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m7 9 3 3-3 3m6 0h4" />
        </svg>
      </div>
      <div>
        <span class="legend">01 / Your agent</span>
        <div class="example">“{example}”</div>
      </div>
    </div>
    <div class="link-line" data-stop="bridge"><span>MCP client forwards the write</span></div>

    <div class="system">
      <div class="system-top" data-stop="server">
        <img src="/automem-icon.svg" alt="" width="31" height="31" />
        <div>
          <strong>AutoMem</strong>
          <span>Separate service · your machine or cloud</span>
        </div>
      </div>

      <div class="split-labels">
        <div>Save the record</div>
        <div>Queue semantic indexing</div>
      </div>
      <div class="stores">
        <div class="destination graph" data-stop="graph">
          <svg class="destination-icon" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="m6 12 11-6M6 12l11 6m0-12v12" /><circle cx="6" cy="12" r="3" /><circle cx="17" cy="6" r="3" /><circle cx="17" cy="18" r="3" />
          </svg>
          <strong>FalkorDB</strong>
          <span>Memory text and relationships</span>
        </div>
        <div class="semantic">
          <div class="destination embed" data-stop="model">
            <strong data-model="local">FastEmbed <span class="tag">LOCAL</span></strong>
            <strong data-model="hosted" hidden>Voyage or OpenAI <span class="tag">API</span></strong>
            <span data-model="local">Model runs on the server</span>
            <span data-model="hosted" hidden>Text goes out · vector comes back</span>
          </div>
          <div class="vector-line">vector</div>
          <div class="destination vector" data-stop="vector">
            <svg class="destination-icon" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 14v5m5-10v10m5-14v14m5-8v8M3 19h19" />
            </svg>
            <strong>Qdrant</strong>
            <span>Index for finding similar meanings</span>
          </div>
        </div>
      </div>
      <div class="external-link" data-model="hosted" hidden><span aria-hidden="true">↕</span> Outside the AutoMem service</div>
    </div>

    <div class="external" data-model="hosted" data-stop="model" hidden>
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6.5 18a4.5 4.5 0 1 1 .7-8.9 5.5 5.5 0 0 1 10.3 1.1A4 4 0 1 1 18 18z" />
      </svg>
      <div><strong>Hosted embedding API</strong><span>Receives memory and query text</span></div>
    </div>
  </div>

  <div class="trace-footer">
    <div>
      <span class="legend footer-label">LATER / ANOTHER CHAT</span>
      <span class="recall">“What language should I start with?” <strong>→ TypeScript.</strong></span>
    </div>
    <button class="play" type="button" data-play hidden>
      <span aria-hidden="true">▷</span> Trace write
    </button>
  </div>
  <span class="sr-trace" role="status" data-status></span>
</memory-trace>

<script>
  class MemoryTrace extends HTMLElement {
    connectedCallback() {
      const controls = this.querySelector<HTMLElement>('.trace-controls');
      const buttons = this.querySelectorAll<HTMLButtonElement>('[data-mode-button]');
      const panels = this.querySelectorAll<HTMLElement>('[data-model]');
      const play = this.querySelector<HTMLButtonElement>('[data-play]');
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!controls || !play || !status || !controls.hidden) return;

      let sequence = 0;
      const stopNodes = this.querySelectorAll<HTMLElement>('[data-stop]');
      const clearTrace = () => {
        sequence += 1;
        stopNodes.forEach((stop) => stop.removeAttribute('data-lit'));
        status.textContent = '';
      };
      const setMode = (mode: string) => {
        clearTrace();
        this.dataset.mode = mode;
        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.modeButton === mode));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.model !== mode;
        });
      };

      controls.hidden = false;
      play.hidden = false;
      buttons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.modeButton ?? 'local')));
      play.addEventListener('click', async () => {
        clearTrace();
        const activeSequence = sequence;
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        for (const phase of [['agent'], ['bridge'], ['server'], ['graph', 'model'], ['vector']]) {
          if (sequence !== activeSequence || !this.isConnected) return;
          stopNodes.forEach((stop) => {
            if (phase.includes(stop.dataset.stop ?? '')) stop.dataset.lit = '';
          });
          if (!reduceMotion) await new Promise((resolve) => setTimeout(resolve, 310));
        }
        if (sequence !== activeSequence || !this.isConnected) return;
        const provider = this.dataset.mode === 'hosted' ? 'the hosted API' : 'FastEmbed';
        status.textContent = `Trace complete. FalkorDB stores the memory. ${provider} produces the vector for Qdrant.`;
      });
    }
  }

  if (!customElements.get('memory-trace')) customElements.define('memory-trace', MemoryTrace);
</script>

<style>
  .trace {
    --trace-bg: #0a111a;
    --trace-ink: #eef3f8;
    --trace-subtle: #a5b4c5;
    --trace-rule: #334458;
    --trace-gold: #f9cf2c;
    --trace-violet: #c796ff;
    --trace-green: #78e0bd;
    display: block;
    overflow: hidden;
    color: var(--trace-ink);
    background: var(--trace-bg);
    border: 1px solid var(--trace-rule);
    border-radius: 1rem;
    box-shadow: 0 14px 44px #0003, 0 0 0 3px #a5b4c513;
    font-family: var(--sl-font-mono);
  }
  .trace :where(div, span, button, strong, svg, img) { margin: 0; }
  .trace-header, .trace-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .75rem;
    padding: .85rem clamp(.9rem, 3vw, 1.5rem);
    background: #121c28;
  }
  .trace-header { border-bottom: 1px solid var(--trace-rule); }
  .trace-footer { border-top: 1px solid var(--trace-rule); }
  .trace-label, .legend {
    font-size: .69rem;
    letter-spacing: .1em;
    font-weight: 700;
    color: var(--trace-subtle);
  }
  .trace-label { color: var(--trace-gold); }
  .trace-id { color: var(--trace-subtle); }
  .lamp {
    display: inline-block;
    width: .48rem;
    height: .48rem;
    margin-right: .45rem;
    border-radius: 50%;
    background: var(--trace-gold);
    box-shadow: 0 0 .6rem #f9cf2c80;
  }
  .trace-controls {
    display: flex;
    gap: .2rem;
    padding: .2rem;
    border: 1px solid var(--trace-rule);
    border-radius: .55rem;
    background: var(--trace-bg);
  }
  .trace-controls[hidden], .play[hidden] { display: none; }
  button {
    color: var(--trace-subtle);
    background: transparent;
    border: 1px solid transparent;
    border-radius: .35rem;
    padding: .42rem .65rem;
    cursor: pointer;
    font: inherit;
    font-size: .73rem;
  }
  button:hover { color: var(--trace-ink); }
  button:focus-visible { outline: 2px solid var(--trace-gold); outline-offset: 2px; }
  button[aria-pressed="true"] { color: var(--trace-gold); background: #273040; }
  .trace-body {
    padding: clamp(.85rem, 3vw, 1.65rem);
    background-image:
      radial-gradient(ellipse at top left, #4e37564d, transparent 58%),
      radial-gradient(#54677b4f 1px, transparent 1px);
    background-size: auto, 15px 15px;
  }
  .agent-line, .system-top, .external {
    display: flex;
    align-items: center;
    gap: .8rem;
  }
  .agent-line {
    padding: .7rem .9rem;
    background: #111b29;
    border: 1px solid var(--trace-rule);
    border-radius: .55rem;
  }
  .agent-symbol {
    display: grid;
    place-items: center;
    color: var(--trace-gold);
    width: 2.6rem;
    height: 2.6rem;
    flex: 0 0 auto;
    background: #242a30;
    border-radius: .45rem;
  }
  .example { font-size: clamp(.83rem, 2vw, 1.1rem); font-weight: 600; }
  .link-line, .split-labels > div, .vector-line {
    position: relative;
    color: var(--trace-subtle);
    font-size: .68rem;
  }
  .link-line {
    margin-left: 2rem;
    padding: .5rem .7rem;
    border-left: 1px solid #6b7788;
  }
  .link-line::after {
    content: '';
    position: absolute;
    bottom: 1px;
    left: -4px;
    width: 7px;
    height: 7px;
    border-right: 1px solid #6b7788;
    border-bottom: 1px solid #6b7788;
    transform: rotate(45deg);
  }
  .system {
    padding: clamp(.7rem, 2.5vw, 1rem);
    background: #121c29;
    border: 1px solid #52647a;
    border-radius: .6rem;
  }
  .system-top { padding: .15rem .3rem .72rem; border-bottom: 1px solid var(--trace-rule); }
  .system-top img { flex: 0 0 auto; }
  .system-top strong { font-size: 1.05rem; letter-spacing: -.03em; }
  .system-top span, .destination > span, .external span { display: block; color: var(--trace-subtle); font-size: .71rem; }
  .split-labels, .stores {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: .55rem;
  }
  .split-labels > div {
    padding: .5rem 0 .5rem .5rem;
    margin-left: .5rem;
    border-left: 1px solid #687a8d;
  }
  .destination {
    position: relative;
    align-self: start;
    min-width: 0;
    border: 1px solid var(--trace-rule);
    border-radius: .45rem;
    padding: .62rem .55rem;
    background: #0b141f;
    overflow-wrap: anywhere;
  }
  .destination-icon { display: block; margin-bottom: .25rem; }
  .graph .destination-icon { color: var(--trace-green); }
  .vector .destination-icon { color: var(--trace-violet); }
  .destination strong, .external strong { font-size: .83rem; }
  .embed strong, .external strong { color: var(--trace-violet); }
  .tag {
    display: inline-block;
    vertical-align: .1em;
    font-size: .55rem;
    font-weight: 700;
    line-height: 1.1;
    padding: .22em .4em;
    border-radius: .2rem;
    color: var(--trace-violet);
    background: #392855;
  }
  .vector-line { padding: .12rem 0 .12rem .5rem; margin-left: .6rem; border-left: 1px solid #8c61b0; color: var(--trace-violet); }
  .external-link {
    font-size: .67rem;
    padding-top: .5rem;
    text-align: right;
    color: var(--trace-violet);
  }
  [data-model][hidden] { display: none; }
  .external {
    color: var(--trace-violet);
    margin: .5rem 0 0 auto;
    padding: .55rem .7rem;
    width: max-content;
    max-width: 100%;
    border: 1px dashed #8c61b0;
    border-radius: .45rem;
    background: #201735;
  }
  .external svg { flex: 0 0 auto; }
  .footer-label { display: block; color: var(--trace-green); }
  .recall { color: var(--trace-subtle); font-size: .76rem; }
  .recall strong { color: var(--trace-ink); }
  .play {
    color: var(--trace-gold);
    border-color: #73632e;
    background: #25251d;
    white-space: nowrap;
  }
  .play:hover { background: #39331c; }
  [data-stop] { transition: border-color .24s ease, box-shadow .24s ease; }
  [data-lit] { border-color: var(--trace-gold); box-shadow: inset 0 0 1.15rem #f9cf2c21; }
  .system-top[data-lit], .link-line[data-lit] { color: var(--trace-gold); }
  .sr-trace { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { [data-stop] { transition: none; } }
</style>
